{
  "name": "@iconsauce/core",
  "version": "2.0.0",
  "description": "Includes only the SVG icons matched in your code and generates a CSS icon font set.",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "npm run clean && tsc --declaration -p tsconfig.build.json",
    "postbuild": "cp -r ./build/src ./lib",
    "clean": "rm -rf build lib coverage .temp",
    "dev": "tsc --watch",
    "lint": "eslint --fix",
    "prepublishOnly": "npm run build && npm run test",
    "test": "jest"
  },
  "bin": {
    "iconsauce": "lib/cli.js"
  },
  "files": [
    "lib"
  ],
  "dependencies": {
    "@iconsauce/mdi-svg": "^1.0.8",
    "@iconsauce/mgg-icons": "^1.2.0",
    "@iconsauce/material-icons": "^1.0.3",
    "@iconsauce/plugin": "^0.1.0",
    "arg": "5.0.2",
    "chalk": "4.1.2",
    "fast-glob": "3.3.3",
    "fonteditor-core": "2.6.3",
    "fs-extra": "11.3.0",
    "handlebars": "4.7.9",
    "lilconfig": "3.1.3",
    "svgicons2svgfont": "16.0.0"
  },
  "overrides": {
    "glob": "13.0.6",
    "test-exclude": "8.0.0"
  },
  "devDependencies": {
    "@babel/preset-env": "7.29.0",
    "@babel/preset-typescript": "7.28.5",
    "@eslint/eslintrc": "3.3.4",
    "@eslint/js": "9.39.3",
    "@maggioli-design-system/svg-icons": "3.11.7",
    "@material-icons/svg": "1.0.33",
    "@mdi/svg": "7.3.67",
    "@types/debug": "4.1.12",
    "@types/fs-extra": "11.0.4",
    "@types/jest": "30.0.0",
    "@types/node": "25.3.3",
    "eslint": "9.39.3",
    "jest": "30.3.0",
    "material-design-icons-updated": "7.0.0",
    "prettier": "3.4.2",
    "ts-jest": "29.4.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.60.0"
  },
  "keywords": [
    "build",
    "icon",
    "svg",
    "incremental",
    "jit"
  ],
  "author": {
    "email": "vittorio.vittori@maggioli.it",
    "name": "Vittorio Vittori",
    "role": "Design System Architect",
    "url": "https://github.com/vitto"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iconsauce/iconsauce.git"
  },
  "contributors": [
    {
      "name": "Andrea Pruccoli",
      "email": "andrea.pruccoli@maggioli.it",
      "role": "Software Engineer"
    },
    {
      "name": "Nicola Tamburini",
      "email": "nicola.tamburini@maggioli.it",
      "role": "Software Engineer"
    }
  ],
  "license": "ISC"
}
